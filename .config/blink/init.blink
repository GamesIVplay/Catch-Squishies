option ClientOutput = "../../network/Client.luau"
option ServerOutput = "../../network/Server.luau"
option Casing = Pascal

import "./Types.blink" as Types

event ClientLoaded {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true
}

event Notification {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        Text: string,
        Duration: u8?,
        Type: Types.NotificationType
    }
}

event SellDialogMessage {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: string(0..240)
}

event SellEffect {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true
}

event TutorialCompleteEffect {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        PlayerUserId: Types.Id
    }
}

event TutorialSubevent {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: Types.TutorialSubevent
}

