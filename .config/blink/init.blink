event LassoThrowStarted {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        AimOriginX: f64,
        AimOriginY: f64,
        AimOriginZ: f64,
        AimDirectionX: f64,
        AimDirectionY: f64,
        AimDirectionZ: f64
    }
}

event LassoThrowVisual {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        PlayerUserId: Types.Id,
        LassoName: Types.Lasso,
        AimOriginX: f64,
        AimOriginY: f64,
        AimOriginZ: f64,
        AimDirectionX: f64,
        AimDirectionY: f64,
        AimDirectionZ: f64
    }
}

event StartCatch {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        AimOriginX: f64,
        AimOriginY: f64,
        AimOriginZ: f64,
        AimDirectionX: f64,
        AimDirectionY: f64,
        AimDirectionZ: f64
    }
}

event CatchClick {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId
    }
}

event CancelCatch {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId
    }
}

event CatchStarted {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId,
        TargetEntity: Types.Id,
        TargetName: Types.SquishyName,
        TargetKind: Types.SquishyKind,
        TargetImage: Types.AssetImage,
        TargetRarity: Types.SquishyRarity,
        Strength: u16,
        ClicksNeeded: u16,
        Difficulty: u8,
        DepletionTweenTime: f64,
        LockProgress: f64,
        Progress: f64
    }
}

event CatchProgress {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId,
        Progress: f64,
        TweenTime: f64?
    }
}

event CatchLocked {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId
    }
}

event CatchCancelled {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId,
        Reason: Types.CatchCancelReason,
        Message: Types.CatchMessage
    }
}

event CatchCompleted {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId,
        ItemId: Types.InventoryItemId,
        HotbarSlot: u8?
    }
}

event CatchPullEffect {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        CatchId: Types.CatchId,
        PlayerUserId: Types.Id
    }
}
