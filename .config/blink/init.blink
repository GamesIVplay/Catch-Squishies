event WalkingSquishyChanged {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        PlayerUserId: Types.Id,
        Equipped: boolean,
        ItemId: Types.InventoryItemId,
        Kind: Types.SquishyKind,
        Name: Types.InventoryItemName,
	        Rarity: Types.SquishyRarity,
	        Weight: f64,
	        Mutation: Types.Mutation,
	        EventMutations: Types.EventMutation[0..8],
	        Level: u8,
	        BaseIncomePerSec: u32,
	        FinalIncomePerSec: u32,
	        LassoName: Types.Lasso
	    }
}

event PlotSquishiesChanged {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        PlayerUserId: Types.Id,
        SuppressCollectBounce: boolean?,
        Items: struct {
            Id: Types.InventoryItemId,
            Type: Types.InventoryItemType,
            Kind: Types.SquishyKind,
            Name: Types.InventoryItemName,
            Rarity: Types.SquishyRarity,
            Image: Types.AssetImage,
            BaseIncomePerSec: u32,
            FinalIncomePerSec: u32,
            Weight: f64,
            Mutation: Types.Mutation,
            EventMutations: Types.EventMutation[0..8],
            Level: u8,
            XP: u32,
            Favorite: boolean,
            TutorialRole: string(0..16)?,
            PositionX: f64,
            PositionY: f64,
            PositionZ: f64,
            StoredCash: f64,
            LastCashUpdate: f64,
            MoveState: Types.PlotSquishyMoveState,
            MoveStartX: f64,
            MoveStartY: f64,
            MoveStartZ: f64,
            MoveTargetX: f64,
            MoveTargetY: f64,
            MoveTargetZ: f64,
            MoveStartedAt: f64,
            MoveDuration: f64,
            IdleUntil: f64,
            MoveIndex: u32
        }[0..128]
    }
}

