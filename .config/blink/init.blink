event OwnedSquishiesChanged {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        Id: Types.InventoryItemId,
        Type: Types.InventoryItemType,
        Kind: Types.SquishyKind,
        Name: Types.InventoryItemName,
        Rarity: Types.SquishyRarity,
        Image: Types.AssetImage,
        BaseIncomePerSec: u32,
        FinalIncomePerSec: u32,
        Weight: f64,
        Mutation: Types.Mutation,
        EventMutations: Types.EventMutation[0..8],
        Level: u8,
        XP: u32,
        Equipped: boolean,
        Favorite: boolean,
        HotbarSlot: u8?
    }[0..512]
}

event OwnedFoodChanged {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        Id: Types.InventoryItemId,
        Type: Types.InventoryItemType,
        Name: Types.InventoryItemName,
        Rarity: Types.SquishyRarity,
        Image: Types.AssetImage,
        Amount: u16,
        XPValue: u32,
        Favorite: boolean,
        HotbarSlot: u8?
    }[0..128]
}

