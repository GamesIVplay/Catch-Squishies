event EventStateChanged {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        NextEventAt: f64,
        ActiveEvents: struct {
            Name: Types.EventName,
            StartedAt: f64,
            EndsAt: f64,
            Source: Types.EventSource
        }[0..8]
    }
}

